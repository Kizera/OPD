-- === 2. ระบบจัดการรายชื่อมอนสเตอร์ ===
local function refreshMobList()
    -- ลบปุ่มเก่าออกให้หมดก่อน
    for _, child in pairs(MobListScroll:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local uniqueMobs = {}
    -- หาชื่อมอนสเตอร์ที่ไม่ซ้ำกันในแมพ
    for _, enemy in pairs(workspace:WaitForChild("Enemies"):GetChildren()) do
        if enemy:IsA("Model") and not uniqueMobs[enemy.Name] then
            uniqueMobs[enemy.Name] = true
        end
    end

    -- สร้างปุ่มสำหรับมอนแต่ละชื่อ
    for mobName, _ in pairs(uniqueMobs) do
        local mobBtn = Instance.new("TextButton")
        mobBtn.Size = UDim2.new(1, 0, 0, 30)
        mobBtn.Text = mobName
        
        -- เช็คสถานะเก่าว่าเคยเลือกไว้มั้ย
        if selectedMobs[mobName] then
            mobBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0) -- สีเขียว (เลือก)
        else
            mobBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60) -- สีเทา (ไม่ได้เลือก)
        end
        
        mobBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        mobBtn.Parent = MobListScroll

        -- ระบบติ๊กเลือกมอน
        mobBtn.MouseButton1Click:Connect(function()
            if selectedMobs[mobName] then
                selectedMobs[mobName] = nil -- เอาออก
                mobBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            else
                selectedMobs[mobName] = true -- เลือก
                mobBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
            end
        end)
    end
    
    -- ปรับขนาด Scroll ตามจำนวนปุ่ม
    MobListScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

-- === 3. ระบบวาร์ปไปด้านหลังเป้าหมาย ===
task.spawn(function()
    while task.wait() do -- รันลูปเช็คตลอดเวลา
        if autoWarp then
            pcall(function()
                local character = player.Character
                if not character or not character:FindFirstChild("HumanoidRootPart") then return end
                
                -- วนหามอนสเตอร์ที่มีชื่อตรงกับที่เราเลือกไว้
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    -- เช็คว่าชื่อมอนอยู่ใน List ที่เลือก, มีเลือด, และปุ่มวาร์ปยังเปิดอยู่
                    if selectedMobs[enemy.Name] and autoWarp then
                        local hum = enemy:FindFirstChild("Humanoid")
                        local hrp = enemy:FindFirstChild("HumanoidRootPart")
                        
                        if hum and hum.Health > 0 and hrp then
                            -- ล็อกเป้าตัวนี้จนกว่าจะตาย
                            while hum.Health > 0 and autoWarp do
                                -- วาร์ปไปด้านหลังมอนสเตอร์ 3.5 หน่วย (ปรับระยะได้ตรง CFrame.new)
                                character.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 0, 3.5)
                                task.wait(0.05) -- ความเร็วในการเกาะหลัง
                            end
                        end
                    end
                end
            end)
        end
    end
end)

