-- === 4. ฟังก์ชันอัปเดตและเรียงรายชื่อมอนสเตอร์ (Sorting) ===
local function updateList()
    for _, v in pairs(MobListScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    
    local unique = {}
    for _, e in pairs(workspace.Enemies:GetChildren()) do 
        if not unique[e.Name] then unique[e.Name] = true end 
    end
    
    local sortedMobs = {}
    for name, _ in pairs(unique) do
        -- สกัดตัวเลขเลเวลออกจากชื่อ (เช่น "Lv710" -> 710)
        local levelStr = string.match(name, "%d+")
        local levelNum = levelStr and tonumber(levelStr) or 0
        table.insert(sortedMobs, {Name = name, Level = levelNum})
    end
    
    -- เรียงลำดับจากเลเวลน้อยไปมาก
    table.sort(sortedMobs, function(a, b)
        if a.Level == b.Level then
            return a.Name < b.Name -- ถ้าเลเวลเท่ากัน ให้เรียงตามตัวอักษร
        end
        return a.Level < b.Level
    end)
    
    -- สร้างปุ่มตามลำดับที่เรียงแล้ว
    for _, mobData in ipairs(sortedMobs) do
        local name = mobData.Name
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 30)
        b.Text = name
        b.BackgroundColor3 = selectedMobs[name] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.Parent = MobListScroll
        
        b.MouseButton1Click:Connect(function()
            selectedMobs[name] = not selectedMobs[name]
            b.BackgroundColor3 = selectedMobs[name] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
        end)
    end
    MobListScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

RefreshBtn.MouseButton1Click:Connect(updateList)
ToggleMenuBtn.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible end)

updateList()
