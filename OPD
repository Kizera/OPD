-- โค้ดปุ่มทำงาน
HitboxBtn.MouseButton1Click:Connect(function()
    expandHitbox = not expandHitbox
    if expandHitbox then
        HitboxBtn.Text = "ปิด Hitbox"
        HitboxBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    else
        HitboxBtn.Text = "เปิด Hitbox คลุมแมพ"
        HitboxBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
    end
end)

