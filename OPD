local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")
local userId = player.UserId
local userDataFolder = workspace:WaitForChild("UserData"):WaitForChild("User_" .. userId)

-- ตัวแปรสถานะ
_G.AutoMagma = _G.AutoMagma or false
_G.AutoRespawn = _G.AutoRespawn or false
_G.AutoTPVokun = _G.AutoTPVokun or false
_G.AutoHaki = _G.AutoHaki or false

-- พิกัดบอส Vokun
local FarmPos = Vector3.new(4571, 221, 5122)

-- === 1. ระบบเช็คสถานะและจัดการตำแหน่ง (Vokun Lock) ===
task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoTPVokun then
            pcall(function()
                local char = player.Character
                local hum = char and char:FindFirstChild("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                if not char or not hum or hum.Health <= 0 then
                    if _G.AutoRespawn then
                        for i = 0, 9 do
                            game:GetService("ReplicatedStorage").Connections.Spawn:FireServer(i)
                        end
                    end
                elseif hrp and (hrp.Position - FarmPos).Magnitude > 10 then
                    hrp.CFrame = CFrame.new(FarmPos)
                end
            end)
        end
    end
end)

-- === 2. ระบบสกิล Magma (ยิงไปข้างหน้า) ===
local function fireMagma()
    pcall(function()
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local remote = char:FindFirstChild("Powers") and char.Powers:FindFirstChild("Magma") and char.Powers.Magma:FindFirstChild("RemoteEvent")
        
        if remote and hrp then
            local forwardPos = hrp.CFrame * CFrame.new(0, 0, -10)
            local args = {
                "MagmaPower4",
                "Create",
                forwardPos,
                workspace:FindFirstChild("Enemies")
            }
            remote:FireServer(unpack(args))
        end
    end)
end

task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoMagma then fireMagma() end
    end
end)

-- === 3. ระบบ Safe Haki Farm (คำนวณเลือดกันตาย) ===
task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoHaki then
            pcall(function()
                local char = player.Character
                local hum = char and char:FindFirstChild("Humanoid")
                
                if hum and hum.Health > 0 then
                    -- คำนวณเลเวลฮาคิสูงสุดที่เลือดเราจ่ายไหว (เหลือเลือดก้นหลอดไว้ 500)
                    local safeLevel = math.floor((hum.Health - 500) / 20)
                    if safeLevel < 248 then safeLevel = 248 end -- ล็อคขั้นต่ำไว้ที่ 248
                    
                    local kenRemote = userDataFolder:FindFirstChild("III")
                    local busoRemote = userDataFolder:FindFirstChild("UpdateHaki")
                    
                    if kenRemote and busoRemote then
                        -- เปิด Ken Haki
                        kenRemote:FireServer("On", safeLevel)
                        -- สแปม Update Buso รับ EXP
                        busoRemote:FireServer()
                        task.wait(0.2)
                        -- ปิด Ken Haki
                        kenRemote:FireServer("Off", safeLevel)
                    end
                end
            end)
        end
    end
end)

