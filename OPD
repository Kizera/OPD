-- พิกัดจุดยืนฟาร์ม (ลูกพี่กำหนด)
local FarmPos = Vector3.new(4571, 221, 5122)

-- === 1. ระบบเกิดใหม่ (วนลูป 0-9) และวาร์ปกลับที่เดิม ===
local function handleRespawn()
    pcall(function()
        local spawnRemote = game:GetService("ReplicatedStorage"):WaitForChild("Connections"):WaitForChild("Spawn")
        -- วนลูปเกิด 0-9 ตามที่ลูกพี่ต้องการ
        for i = 0, 9 do
            spawnRemote:FireServer(i)
        end
    end)
end

-- เช็คการเกิดใหม่
player.CharacterAdded:Connect(function(char)
    if _G.AutoRespawn then
        local hrp = char:WaitForChild("HumanoidRootPart", 10)
        if hrp then
            task.wait(0.5) -- รอให้ฟิสิกส์โหลดแป๊บหนึ่ง
            hrp.CFrame = CFrame.new(FarmPos) -- วาร์ปกลับจุดฟาร์มทันที
            print("วาร์ปกลับจุดเดิมเรียบร้อย!")
        end
    end
end)

-- === 2. ระบบสกิล Magma (ยิงไปข้างหน้าตัวละคร) ===
local function fireMagma()
    pcall(function()
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local remote = char:FindFirstChild("Powers") and char.Powers:FindFirstChild("Magma") and char.Powers.Magma:FindFirstChild("RemoteEvent")
        
        if remote and hrp then
            -- คำนวณตำแหน่งด้านหน้าตัวละคร 10 หน่วย
            local forwardPos = hrp.CFrame * CFrame.new(0, 0, -10)
            
            -- ปรับโครงสร้าง Argument ให้เล็งไปข้างหน้าเสมอ
            local args = {
                "MagmaPower4",
                "Create",
                forwardPos, -- ส่งตำแหน่งด้านหน้าเราไปแทนตำแหน่งเมาส์
                workspace:FindFirstChild("Enemies") -- เล็งเข้าโฟลเดอร์ศัตรูโดยรวม
            }
            remote:FireServer(unpack(args))
        end
    end)
end

-- === 3. ลูปการทำงานหลัก ===
task.spawn(function()
    while task.wait(1) do
        local char = player.Character
        if _G.AutoRespawn then
            if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                handleRespawn()
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.5) do -- สแปมสกิล Magma ทุก 0.5 วิ
        if _G.AutoMagma then fireMagma() end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        local char = player.Character
        if char and _G.AutoEquip then
            local tool = player.Backpack:FindFirstChild("Krizma")
            if tool then char.Humanoid:EquipTool(tool) end
        end
        if char and _G.AutoClick then
            game:GetService("VirtualUser"):Button1Down(Vector2.new(0,0))
            task.wait(0.05)
            game:GetService("VirtualUser"):Button1Up(Vector2.new(0,0))
        end
    end
end)

