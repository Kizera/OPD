local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

-- ตัวแปรสถานะ
_G.AutoWarp = _G.AutoWarp or false
_G.AutoEquip = _G.AutoEquip or false
_G.AutoClick = _G.AutoClick or false
_G.AutoRespawn = _G.AutoRespawn or false
_G.GhostMode = _G.GhostMode or false
_G.AutoSkillB = _G.AutoSkillB or false
_G.AutoSkillV = _G.AutoSkillV or false

local selectedMobs = {}

-- === 1. ฟังก์ชันจัดการตัวละคร ===
local function getCharacter()
    return player.Character or player.CharacterAdded:Wait()
end

local function applyGhostMode(char)
    if _G.GhostMode then
        task.wait(0.5)
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = 1
            elseif part:IsA("Decal") then part.Transparency = 1 end
        end
    end
end

-- === 2. ระบบ Auto Skills (Flare V & B) ===
local function fireSkillV()
    pcall(function()
        local char = player.Character
        if not char then return end
        local remote = char:FindFirstChild("Powers") and char.Powers:FindFirstChild("Flare") and char.Powers.Flare:FindFirstChild("RemoteEvent")
        
        if remote then
            -- สกิล V ยิงแค่ชื่อสกิล ไม่ต้องการพิกัด
            remote:FireServer("FlarePower4")
        end
    end)
end

local function fireSkillB()
    pcall(function()
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local remote = char:FindFirstChild("Powers") and char.Powers:FindFirstChild("Flare") and char.Powers.Flare:FindFirstChild("RemoteEvent")
        
        if remote and hrp then
            -- จังหวะที่ 1: เริ่มชาร์จ (ลงเท้าตัวเอง)
            remote:FireServer("FlarePower5", "StartCharging", hrp.CFrame, hrp, "Left")
            
            task.wait(0.1) -- หน่วงเวลาชาร์จ 0.1 วิ (ปรับให้เร็วสุดเท่าที่ดาเมจจะออก)
            
            -- จังหวะที่ 2: ปล่อยพลัง (ลงเท้าตัวเอง)
            remote:FireServer("FlarePower5", "StopCharging", hrp.CFrame, hrp, 6)
        end
    end)
end

task.spawn(function()
    while task.wait(0.5) do -- สแปมทุกๆ 0.5 วินาที
        if _G.AutoSkillV then fireSkillV() end
        if _G.AutoSkillB then fireSkillB() end
    end
end)

-- === 3. ระบบทำงานอื่นๆ ===
task.spawn(function()
    while task.wait(1) do
        local char = player.Character
        if _G.AutoRespawn and (not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0) then
            pcall(function() game:GetService("ReplicatedStorage").Connections.Spawn:FireServer(2) end)
        end
        if char and _G.GhostMode then applyGhostMode(char) end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        local char = player.Character
        if char and _G.AutoEquip then
            local tool = player.Backpack:FindFirstChild("Krizma")
            if tool then char.Humanoid:EquipTool(tool) end
        end
        if char and _G.AutoClick and char:FindFirstChild("Krizma") then
            char.Krizma:Activate()
        end
    end
end)

task.spawn(function()
    while task.wait() do
        if _G.AutoWarp then
            pcall(function()
                local char = getCharacter()
                local hrp = char:WaitForChild("HumanoidRootPart", 5)
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if selectedMobs[enemy.Name] and _G.AutoWarp then
                        local hum = enemy:FindFirstChild("Humanoid")
                        local ehrp = enemy:FindFirstChild("HumanoidRootPart")
                        if hum and hum.Health > 0 and ehrp then
                            while hum.Health > 0 and _G.AutoWarp and char.Humanoid.Health > 0 do
                                hrp.CFrame = ehrp.CFrame * CFrame.new(0, 0, 3.5)
                                task.wait(0.01)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

