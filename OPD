local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

-- ตัวแปรสถานะ
_G.AutoMagma = _G.AutoMagma or false
_G.AutoRespawn = _G.AutoRespawn or false
_G.AutoTPVokun = _G.AutoTPVokun or false

-- พิกัดบอส Vokun
local FarmPos = Vector3.new(4571, 221, 5122)

-- === 1. ระบบเช็คสถานะและจัดการตำแหน่ง (The Heart of V11) ===
task.spawn(function()
    while task.wait(0.5) do -- เช็คทุกๆ 0.5 วินาที (ไม่กินสเปคแต่ไวพอ)
        if _G.AutoTPVokun then
            pcall(function()
                local char = player.Character
                local hum = char and char:FindFirstChild("Humanoid")
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                
                -- เงื่อนไขที่ 1: ถ้าเลือดหมด หรือ ตัวละครหายไป (ตาย)
                if not char or not hum or hum.Health <= 0 then
                    if _G.AutoRespawn then
                        -- วนลูปส่งคำสั่งเกิดใหม่ 0-9
                        for i = 0, 9 do
                            game:GetService("ReplicatedStorage").Connections.Spawn:FireServer(i)
                        end
                    end
                
                -- เงื่อนไขที่ 2: ถ้ายังไม่ตาย แต่ตำแหน่งอยู่ห่างจากจุดฟาร์มเกิน 10 หน่วย (เช่น อยู่ที่ Lobby)
                elseif hrp and (hrp.Position - FarmPos).Magnitude > 10 then
                    hrp.CFrame = CFrame.new(FarmPos)
                    print("ตรวจพบตำแหน่งเพี้ยน! กระชากกลับจุดฟาร์ม Vokun เรียบร้อย")
                end
            end)
        end
    end
end)

-- === 2. ระบบสกิล Magma (ยิงไปข้างหน้าตัวละคร) ===
local function fireMagma()
    pcall(function()
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local remote = char:FindFirstChild("Powers") and char.Powers:FindFirstChild("Magma") and char.Powers.Magma:FindFirstChild("RemoteEvent")
        
        if remote and hrp then
            local forwardPos = hrp.CFrame * CFrame.new(0, 0, -10)
            local args = {
                "MagmaPower4",
                "Create",
                forwardPos,
                workspace:FindFirstChild("Enemies")
            }
            remote:FireServer(unpack(args))
        end
    end)
end

task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoMagma then fireMagma() end
    end
end)

