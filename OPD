-- === 3. ระบบทำงาน (Loops) ===

-- Auto Respawn Loop
task.spawn(function()
    while task.wait(1) do
        if autoRespawn then
            local char = player.Character
            if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                pcall(function()
                    local args = { 2 }
                    game:GetService("ReplicatedStorage"):WaitForChild("Connections"):WaitForChild("Spawn"):FireServer(unpack(args))
                end)
            end
        end
    end
end)

-- Auto Equip & Click Loop
task.spawn(function()
    while task.wait(0.1) do
        if autoEquip then equipKrizma() end
        if autoClick then
            local char = player.Character
            if char and char:FindFirstChild("Krizma") then
                char.Krizma:Activate()
            end
        end
    end
end)

-- Auto Warp Loop
task.spawn(function()
    while task.wait() do
        if autoWarp then
            pcall(function()
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if selectedMobs[enemy.Name] and autoWarp then
                        local hum = enemy:FindFirstChild("Humanoid")
                        local ehrp = enemy:FindFirstChild("HumanoidRootPart")
                        if hum and hum.Health > 0 and ehrp then
                            while hum.Health > 0 and autoWarp do
                                hrp.CFrame = ehrp.CFrame * CFrame.new(0, 0, 3.5)
                                task.wait(0.01)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- === 4. จัดการ Events ===

local function updateList()
    for _, v in pairs(MobListScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local unique = {}
    for _, e in pairs(workspace.Enemies:GetChildren()) do if not unique[e.Name] then unique[e.Name] = true end end
    for name, _ in pairs(unique) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 30)
        b.Text = name
        b.BackgroundColor3 = selectedMobs[name] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.Parent = MobListScroll
        b.MouseButton1Click:Connect(function()
            selectedMobs[name] = not selectedMobs[name]
            b.BackgroundColor3 = selectedMobs[name] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
        end)
    end
    MobListScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

local function toggleSetting(btn, varName, text)
    if varName == "autoWarp" then autoWarp = not autoWarp
    elseif varName == "autoEquip" then autoEquip = not autoEquip
    elseif varName == "autoClick" then autoClick = not autoClick
    elseif varName == "autoRespawn" then autoRespawn = not autoRespawn end
    
    local active = (varName == "autoWarp" and autoWarp) or (varName == "autoEquip" and autoEquip) or (varName == "autoClick" and autoClick) or (varName == "autoRespawn" and autoRespawn)
    btn.Text = text .. (active and " (ON)" or " (OFF)")
    btn.BackgroundColor3 = active and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
end

WarpBtn.MouseButton1Click:Connect(function() toggleSetting(WarpBtn, "autoWarp", "Auto Warp") end)
EquipBtn.MouseButton1Click:Connect(function() toggleSetting(EquipBtn, "autoEquip", "Auto Equip Krizma") end)
ClickBtn.MouseButton1Click:Connect(function() toggleSetting(ClickBtn, "autoClick", "Auto Click") end)
RespawnBtn.MouseButton1Click:Connect(function() toggleSetting(RespawnBtn, "autoRespawn", "Auto Respawn") end)

RefreshBtn.MouseButton1Click:Connect(updateList)
ToggleMenuBtn.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible end)

updateList()
