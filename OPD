local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

-- ตัวแปรสถานะ
_G.AutoWarp = _G.AutoWarp or false
_G.AutoEquip = _G.AutoEquip or false
_G.AutoClick = _G.AutoClick or false
_G.AutoRespawn = _G.AutoRespawn or false
_G.GhostMode = _G.GhostMode or false
local selectedMobs = {}

-- === 1. ฟังก์ชันจัดการตัวละคร ===
local function getCharacter()
    return player.Character or player.CharacterAdded:Wait()
end

local function applyGhostMode(char)
    if _G.GhostMode then
        task.wait(0.5)
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = 1
            elseif part:IsA("Decal") then
                part.Transparency = 1
            end
        end
    end
end

-- === 2. ระบบทำงานหลัก ===

-- Auto Respawn & Ghost Apply
task.spawn(function()
    while task.wait(1) do
        local char = player.Character
        if _G.AutoRespawn then
            if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then
                pcall(function()
                    game:GetService("ReplicatedStorage"):WaitForChild("Connections"):WaitForChild("Spawn"):FireServer(2)
                end)
            end
        end
        if char and _G.GhostMode then applyGhostMode(char) end
    end
end)

-- Auto Equip & Click
task.spawn(function()
    while task.wait(0.1) do
        local char = player.Character
        if char and _G.AutoEquip then
            local tool = player.Backpack:FindFirstChild("Krizma")
            if tool then char.Humanoid:EquipTool(tool) end
        end
        if char and _G.AutoClick and char:FindFirstChild("Krizma") then
            char.Krizma:Activate()
        end
    end
end)

-- Auto Warp
task.spawn(function()
    while task.wait() do
        if _G.AutoWarp then
            pcall(function()
                local char = getCharacter()
                local hrp = char:WaitForChild("HumanoidRootPart", 5)
                if not hrp then return end
                
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if selectedMobs[enemy.Name] and _G.AutoWarp then
                        local hum = enemy:FindFirstChild("Humanoid")
                        local ehrp = enemy:FindFirstChild("HumanoidRootPart")
                        
                        if hum and hum.Health > 0 and ehrp then
                            while hum.Health > 0 and _G.AutoWarp and char.Humanoid.Health > 0 do
                                hrp.CFrame = ehrp.CFrame * CFrame.new(0, 0, 3.5)
                                task.wait(0.01)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

