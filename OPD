local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

local expandHitbox = false
local platform = nil
local MaxSize = 2048 -- ขนาดกว้างสุดที่ขยายได้

-- === 1. ระบบสร้างพื้นที่ลอยฟ้า (Safe Zone) ===
local function createSkyBase()
    if not platform then
        platform = Instance.new("Part")
        platform.Size = Vector3.new(50, 1, 50)
        platform.Position = Vector3.new(rootPart.Position.X, 10000, rootPart.Position.Z)
        platform.Anchored = true
        platform.BrickColor = BrickColor.new("Electric blue")
        platform.Material = Enum.Material.Neon
        platform.Parent = workspace
    end
    -- วาร์ปตัวเราขึ้นไป
    rootPart.CFrame = platform.CFrame + Vector3.new(0, 5, 0)
end

-- === 2. ระบบขยาย Hitbox มอนสเตอร์ (ลดอาการแลค) ===
task.spawn(function()
    while task.wait(1) do
        if expandHitbox then
            pcall(function()
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") then
                        local hum = enemy:FindFirstChild("Humanoid")
                        if hum and hum.Health > 0 then
                            local hrp = enemy.HumanoidRootPart
                            hrp.Size = Vector3.new(MaxSize, MaxSize, MaxSize)
                            hrp.Transparency = 0.95 -- โปรงใสจะได้ไม่บังจอขาว
                            hrp.CanCollide = false -- ปิดการชนเพื่อลดการคำนวณฟิสิกส์
                        end
                    end
                end
            end)
        end
    end
end)

