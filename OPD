local Library = {} -- สร้าง GUI แบบง่ายๆ สไตล์พี่ลูน่า
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

local bringing = false
local platform = nil

-- === 1. ระบบสร้างพื้นที่ลอยฟ้า (Safe Zone) ===
local function createSkyBase()
    if not platform then
        platform = Instance.new("Part")
        platform.Size = Vector3.new(50, 1, 50)
        platform.Position = Vector3.new(rootPart.Position.X, 10000, rootPart.Position.Z)
        platform.Anchored = true
        platform.BrickColor = BrickColor.new("Electric blue")
        platform.Material = Enum.Material.Neon
        platform.Parent = workspace
        
        -- วาร์ปตัวเราขึ้นไป
        rootPart.CFrame = platform.CFrame + Vector3.new(0, 5, 0)
    else
        rootPart.CFrame = platform.CFrame + Vector3.new(0, 5, 0)
    end
end

-- === 2. ระบบรวบมอนสเตอร์ (Mob Bringer) ===
task.spawn(function()
    while task.wait(0.1) do
        if bringing then
            pcall(function()
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if enemy:IsA("Model") and enemy:FindFirstChild("HumanoidRootPart") then
                        local enemyHumanoid = enemy:FindFirstChild("Humanoid")
                        if enemyHumanoid and enemyHumanoid.Health > 0 then
                            -- รวบมาไว้ข้างหน้าตัวเรา 5 หน่วย
                            enemy.HumanoidRootPart.CFrame = rootPart.CFrame * CFrame.new(0, 0, -5)
                            enemy.HumanoidRootPart.CanCollide = false -- ป้องกันมอนดีด
                        end
                    end
                end
            end)
        end
    end
end)

