local player = game:GetService("Players").LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

local autoKill = false
local platform = nil

-- === 1. ระบบฐานลอยฟ้า (หนีตายไปอยู่ข้างบน) ===
local function createSkyBase()
    if not platform then
        platform = Instance.new("Part")
        platform.Size = Vector3.new(50, 1, 50)
        platform.Position = Vector3.new(rootPart.Position.X, 10000, rootPart.Position.Z)
        platform.Anchored = true
        platform.BrickColor = BrickColor.new("Electric blue")
        platform.Material = Enum.Material.Neon
        platform.Parent = workspace
    end
    rootPart.CFrame = platform.CFrame + Vector3.new(0, 5, 0)
end

-- === 2. ระบบ AoE Ground Nuke (สแปมสกิลลงพื้น) ===
task.spawn(function()
    while task.wait(0.1) do -- ความเร็วในการสแปม (0.1 วิ)
        if autoKill then
            pcall(function()
                local char = player.Character
                if not char then return end
                
                -- ตรวจหาพลัง Flare ในตัวละครเรา
                local powers = char:FindFirstChild("Powers")
                local flare = powers and powers:FindFirstChild("Flare")
                local remote = flare and flare:FindFirstChild("RemoteEvent")
                
                if remote then
                    -- Argument ชุดใหม่ที่ลูกพี่หามา (เล็งเป้าไปที่พื้นตรง IslandCliffs)
                    local args = {
                        "FlarePower2",
                        "StopCharging",
                        CFrame.new(4594.9453125, 214.60000610351562, 5274.6884765625, -0.8987636566162109, -0.08513263612985611, 0.43008872866630554, -7.450580596923828e-09, 0.9809670448303223, 0.19417457282543182, -0.438433438539505, 0.17451705038547516, -0.8816574811935425),
                        workspace:WaitForChild("IslandCliffs"):WaitForChild("Path"):WaitForChild("Part"),
                        4
                    }
                    
                    -- ยิงคำสั่งอัดลงพื้นรัวๆ
                    remote:FireServer(unpack(args))
                end
            end)
        end
    end
end)

