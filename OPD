local player = game:GetService("Players").LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

local autoKill = false
local platform = nil

-- === 1. ระบบฐานลอยฟ้า ===
local function createSkyBase()
    if not platform then
        platform = Instance.new("Part")
        platform.Size = Vector3.new(50, 1, 50)
        platform.Position = Vector3.new(rootPart.Position.X, 10000, rootPart.Position.Z)
        platform.Anchored = true
        platform.BrickColor = BrickColor.new("Electric blue")
        platform.Material = Enum.Material.Neon
        platform.Parent = workspace
    end
    rootPart.CFrame = platform.CFrame + Vector3.new(0, 5, 0)
end

-- === 2. ระบบ Kill Aura (ยิง Remote ตรง ไม่แลค) ===
task.spawn(function()
    while task.wait(0.1) do -- สแปมทุก 0.1 วินาที
        if autoKill then
            pcall(function()
                local char = player.Character
                if not char then return end
                
                -- ตรวจหา Remote สกิล Flare ในตัวละครเรา
                local powers = char:FindFirstChild("Powers")
                local flare = powers and powers:FindFirstChild("Flare")
                local remote = flare and flare:FindFirstChild("RemoteEvent")
                
                if remote then
                    for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                        local hum = enemy:FindFirstChild("Humanoid")
                        -- เล็งไปที่ Torso ตามโค้ดต้นฉบับ ถ้าไม่มีให้เล็ง RootPart แทน
                        local targetPart = enemy:FindFirstChild("Torso") or enemy:FindFirstChild("HumanoidRootPart")
                        
                        if hum and hum.Health > 0 and targetPart then
                            -- สร้างชุดคำสั่งส่งไปยิงมอนสเตอร์ทีละตัว
                            local args = {
                                "FlarePower2",
                                "StopCharging",
                                targetPart.CFrame, -- ยัด CFrame ทับตัวมอนไปเลยเพื่อความแม่นยำ
                                targetPart, -- ชิ้นส่วนที่โดนดาเมจ
                                4
                            }
                            -- ยิงคำสั่งโจมตีใส่เซิร์ฟเวอร์
                            remote:FireServer(unpack(args))
                        end
                    end
                end
            end)
        end
    end
end)

