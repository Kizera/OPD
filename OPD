ToggleMenuBtn.Text = "Menu"
ToggleMenuBtn.Parent = ScreenGui

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 250, 0, 580)
MainFrame.Position = UDim2.new(0.5, -125, 0.5, -290)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local function createBtn(text, pos, varName)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -20, 0, 35)
    btn.Position = pos
    btn.Text = text .. (_G[varName] and " (ON)" or " (OFF)")
    btn.BackgroundColor3 = _G[varName] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Parent = MainFrame
    btn.MouseButton1Click:Connect(function()
        _G[varName] = not _G[varName]
        btn.Text = text .. (_G[varName] and " (ON)" or " (OFF)")
        btn.BackgroundColor3 = _G[varName] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(150, 0, 0)
    end)
    return btn
end

createBtn("Auto Warp", UDim2.new(0, 10, 0, 40), "AutoWarp")
createBtn("Auto Equip Krizma", UDim2.new(0, 10, 0, 80), "AutoEquip")
createBtn("Auto Click", UDim2.new(0, 10, 0, 120), "AutoClick")
createBtn("Auto Respawn", UDim2.new(0, 10, 0, 160), "AutoRespawn")
createBtn("Ghost Mode", UDim2.new(0, 10, 0, 200), "GhostMode")
createBtn("Auto Skill B (Flare Nuke)", UDim2.new(0, 10, 0, 240), "AutoSkillB")
createBtn("Auto Skill V (Flare Burst)", UDim2.new(0, 10, 0, 280), "AutoSkillV")

local MobListScroll = Instance.new("ScrollingFrame")
MobListScroll.Size = UDim2.new(1, -20, 1, -380)
MobListScroll.Position = UDim2.new(0, 10, 0, 325)
MobListScroll.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MobListScroll.Parent = MainFrame

local UIListLayout = Instance.new("UIListLayout")
UIListLayout.Parent = MobListScroll

local RefreshBtn = Instance.new("TextButton")
RefreshBtn.Size = UDim2.new(1, -20, 0, 30)
RefreshBtn.Position = UDim2.new(0, 10, 1, -40)
RefreshBtn.Text = "Refresh Mobs"
RefreshBtn.Parent = MainFrame

local function updateList()
    for _, v in pairs(MobListScroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local unique = {}
    for _, e in pairs(workspace.Enemies:GetChildren()) do if not unique[e.Name] then unique[e.Name] = true end end
    local sorted = {}
    for name, _ in pairs(unique) do table.insert(sorted, {Name = name, Level = tonumber(string.match(name, "%d+")) or 0}) end
    table.sort(sorted, function(a,b) return a.Level < b.Level end)
    for _, data in ipairs(sorted) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, 0, 0, 30)
        b.Text = data.Name
        b.BackgroundColor3 = selectedMobs[data.Name] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
        b.TextColor3 = Color3.fromRGB(255, 255, 255)
        b.Parent = MobListScroll
        b.MouseButton1Click:Connect(function()
            selectedMobs[data.Name] = not selectedMobs[data.Name]
            b.BackgroundColor3 = selectedMobs[data.Name] and Color3.fromRGB(0, 150, 0) or Color3.fromRGB(60, 60, 60)
        end)
    end
    MobListScroll.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)
end

RefreshBtn.MouseButton1Click:Connect(updateList)
ToggleMenuBtn.MouseButton1Click:Connect(function() MainFrame.Visible = not MainFrame.Visible end)
updateList()
